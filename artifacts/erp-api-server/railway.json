{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "/artifacts/erp-api-server/**",
      "/artifacts/erp/**",
      "/lib/**",
      "/attached_assets/**",
      "/package.json",
      "/pnpm-workspace.yaml",
      "/pnpm-lock.yaml",
      "/tsconfig.base.json"
    ]
  },
  "deploy": {
    "startCommand": "node --enable-source-maps /app/artifacts/erp-api-server/dist/index.mjs",
    "healthcheckPath": "/api/healthz",
    "healthcheckTimeout": 100,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
